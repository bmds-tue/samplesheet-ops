// Nextflow and nf-schema versions track the most recent nf-core pipeline TEMPLATE
// (nf-core/tools nf_core/pipeline-template/nextflow.config). Never fall behind it.
// When bumping, update both values below and add a row to the "Compatibility"
// table in README.md.
//
// Currently synced with: nf-core/tools 4.2.1 template (released 2026-10-26)

manifest {
    name            = 'bmds-tue/nf-meta-samplesheet-ops'
    homePage        = 'https://github.com/bmds-tue/nf-meta-samplesheet-ops'
    description     = 'Reusable Nextflow connector for samplesheet/metadata operations'
    nextflowVersion = '!>=25.10.4'
}

plugins {
    id 'nf-schema@2.7.3'
}

validation {
    help {
        enabled = true
    }
}
